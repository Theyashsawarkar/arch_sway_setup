# Lock the screen after 5 minutes (same wallpaper as the desktop, via lockconfig's image=)
timeout 300 'swaylock -C ~/.config/sway/lockconfig'

# Turn off the screen after 10 minutes (Power saving)
timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'

# Suspend the system after 30 minutes
timeout 1800 'systemctl suspend'

# Security: Lock the screen immediately before the system enters sleep/suspend
before-sleep 'swaylock -C ~/.config/sway/lockconfig'
