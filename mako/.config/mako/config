# ~/.config/mako/config

# --- Geometry & Positioning ---
# Anchors alerts to the top right corner, perfectly clear of the Waybar pills
anchor=top-right
margin=10,20,0,0
width=350
height=150
border-size=2
border-radius=12
padding=15

# --- Typography ---
font=JetBrainsMono Nerd Font 12
markup=1
format=<b>%s</b>\n%b

# --- Icons ---
# Every notify-send call across this desktop's own scripts now passes a
# real icon (freedesktop icon-theme name, or an actual image path for the
# few that have one -- the wallpaper/screenshot success notifications use
# the actual new image as their icon). Sized and rounded to match the
# rest of the desktop's rounded-pill aesthetic (waybar's 16px, this
# notification's own 12px outer radius) rather than mako's sharp-cornered
# default.
max-icon-size=48
icon-border-radius=8

# --- Elegant Colors ---
# Deep Midnight background with smooth translucency
background-color=#11111Bfa
# Clean silver text for easy readability
text-color=#CDD6F4
# Royal Mauve border outline for standard notifications
border-color=#CBA6F7
# Subtle tracking background for progress bars (like volume adjustments)
progress-color=over #313244

# --- Behavior ---
default-timeout=5000
ignore-timeout=0

# Keep dismissed/expired notifications so scripts/.local/bin/
# notification-history.py (the waybar bell icon, left of the clock) has
# something real to show -- off by default, mako drops notifications
# permanently otherwise. 200 is generous headroom without being
# unbounded; makoctl history/list both return JSON (`-j`), which is what
# that script actually parses.
history=1
max-history=200

# --- Sound ---
# message.oga -- the freedesktop stereo sound theme's default "new
# message" chime, 0.3s (checked every candidate's actual duration with
# ffprobe first rather than guessing from the filename -- the next
# shortest, message-new-instant.oga, runs a full second, noticeably more
# intrusive for something that fires on every single notification).
# Global here (before any [urgency=]/[mode=] section below), not inside
# one -- a real bug caught by testing this directly: an earlier version
# of this line placed after [urgency=high] was silently scoped to *only*
# that section, so normal-urgency notifications never played a sound at
# all despite parsing without any error. mako's own config format scopes
# every option to whatever section most recently opened above it, with
# no way to tell from the option alone -- worth remembering for anything
# added here later.
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message.oga

# --- High Urgency Alerts ---
# Overrides the border to a warm peach tone if a system-critical event occurs
[urgency=high]
border-color=#FAB387
default-timeout=0

# --- Notification modes ---
# scripts/.local/bin/notification-mode.sh switches between these three
# with `makoctl mode -s <name>` -- see that script for the full design
# (why silent/dnd exist, the waybar bell icon + keybindings + scroll
# switching it). "default" (mako's own built-in initial mode, not
# redefined here) is the implicit fourth state: popup shows, sound
# plays, both inherited from the global settings above with nothing to
# override.
[mode=silent]
# Popup still shows (nothing here says otherwise -- inherits every
# geometry/color/timeout setting above unchanged); only the sound is
# cancelled. "none" is on-notify's own documented no-op action, not an
# empty value -- confirmed directly: `on-notify=` with nothing after the
# `=` fails to parse at all ("Failed to parse option 'on-notify='"),
# mako's config format has no bare-empty-value convention here.
on-notify=none

[mode=dnd]
# invisible=1 stops the popup from ever rendering -- confirmed directly
# with the notification's own distinctive Mauve border color (zero
# matching pixels found in a screenshot after firing one in this mode,
# versus a real, matching count when the same check ran against silent
# mode's popup) -- and separately confirmed it does NOT stop the
# notification from being recorded to history (the whole point: DND
# notifications are still fully browsable via notification-history.py
# afterward, just without interrupting anything in the moment).
#
# invisible=1 alone does NOT also cancel on-notify, though -- a real bug
# caught by testing rather than assuming "invisible" implies "silent"
# too: an earlier version of this section had only invisible=1, and a
# sound played anyway despite no popup ever appearing (confirmed with an
# unambiguous marker-file side effect on on-notify, not by ear). Needs
# the same explicit on-notify=none as [mode=silent] above.
invisible=1
on-notify=none
