# ~/.config/mako/config

# --- Geometry & Positioning ---
# Anchors alerts to the top right corner, perfectly clear of the Waybar pills
anchor=top-right
margin=10,20,0,0
width=350
height=150
border-size=2
border-radius=12
padding=15

# --- Typography ---
font=JetBrainsMono Nerd Font 12
markup=1
format=<b>%s</b>\n%b

# --- Icons ---
# Every notify-send call across this desktop's own scripts now passes a
# real icon (freedesktop icon-theme name, or an actual image path for the
# few that have one -- the wallpaper/screenshot success notifications use
# the actual new image as their icon). Sized and rounded to match the
# rest of the desktop's rounded-pill aesthetic (waybar's 16px, this
# notification's own 12px outer radius) rather than mako's sharp-cornered
# default.
max-icon-size=48
icon-border-radius=8

# --- Elegant Colors ---
# Deep Midnight background with smooth translucency
background-color=#11111Bfa
# Clean silver text for easy readability
text-color=#CDD6F4
# Royal Mauve border outline for standard notifications
border-color=#CBA6F7
# Subtle tracking background for progress bars (like volume adjustments)
progress-color=over #313244

# --- Behavior ---
default-timeout=5000
ignore-timeout=0

# Keep dismissed/expired notifications so scripts/.local/bin/
# notification-history.py (the waybar bell icon, left of the clock) has
# something real to show -- off by default, mako drops notifications
# permanently otherwise. 200 is generous headroom without being
# unbounded; makoctl history/list both return JSON (`-j`), which is what
# that script actually parses.
history=1
max-history=200

# --- High Urgency Alerts ---
# Overrides the border to a warm peach tone if a system-critical event occurs
[urgency=high]
border-color=#FAB387
default-timeout=0
