{
	"layer": "top",
	"position": "top",
	"height": 41,
	"spacing": 5,

	"modules-center": ["clock"],
	"modules-left": ["sway/workspaces", "keyboard-state", "custom/docker", "custom/caffeine", "bluetooth"],

	"modules-right": [
		"network", 
		"network#speed",
		"backlight",
		"pulseaudio",
		"battery",
		"custom/power"
	],

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}",
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": []
		}
	},

	"backlight": {
		"format": "  {percent}%",
		"tooltip-format": "Click: drag to set   Scroll: +/-5%",
		"on-click": "/home/yash/.local/bin/brightness-slider.sh",
		"on-scroll-up": "/home/yash/.config/sway/scripts/brightness_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/brightness_osd.sh 5%-",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"keyboard-state": {
		"capslock": true,
		"numlock": true,
		"format": "{name} {icon}",
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},

	"clock": {
	// Formats as: Wed, August 12   02:11 PM
	"format": "  {:%a, %B %d   %I:%M %p}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	"custom/docker": {
		"exec": "docker ps -q | wc -l",
		"interval": 5,
		"format": "  {}",
		"tooltip": false,
		"on-click": "nwg-bar -t /home/yash/.config/nwg-bar/docker.json -s /home/yash/.config/nwg-bar/style.css"
	},

	"network": {
		"format-wifi": "  {essid}  {signalStrength}%",
		"format-ethernet": "  {ipaddr}",
		"format-disconnected": "  Offline",
		"format-disabled": "  Disabled",
		"format-linked": "  No IP",
		"interval": 2,
		"max-length": 30,
		"tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%  ({signaldBm} dBm)\nFrequency: {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"tooltip-format-disabled": "Wi-Fi disabled (rfkill)",
		"on-click": "nwg-bar -t /home/yash/.config/nwg-bar/wifi.json -s /home/yash/.config/nwg-bar/style.css"
	},

	"network#speed": {
		"interval": 2,
		"format": "<span color='#A6E3A1'>⬇ {bandwidthDownBytes}</span>  <span color='#FAB387'>⬆ {bandwidthUpBytes}</span>",
		"tooltip": false
	},

	"bluetooth": {
		"format-off": "",
		"format-on": "",
		"format-connected": "  {device_alias}",
		"format-connected-battery": "  {device_alias}  {device_battery_percentage}%",
		"tooltip-format": "Bluetooth Status: {status}",
		"on-click": "nwg-bar -t /home/yash/.config/nwg-bar/bluetooth.json -s /home/yash/.config/nwg-bar/style.css",
		"max-length": 25
	},

	"custom/caffeine": {
		"exec": "~/.local/bin/caffeine-status.sh",
		"on-click": "~/.local/bin/caffeine-toggle.sh",
		"interval": 5,
		"return-type": "json"
	},

	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}  {capacity}%",
		"format-charging": "  {capacity}%",
		"format-plugged": "  {capacity}%",
		"format-icons": ["", "", "", "", ""]
	},

	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": "  Muted",
		"format-icons": {
			"default": ["", "", ""]
		},
		"tooltip-format": "Click: mute/unmute   Right-click: mixer   Scroll: +/-5%",
		"on-click": "/home/yash/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "/home/yash/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/power": {
		"format": "",
		"tooltip": false,
		"on-click": "nwg-bar"
	}
}
