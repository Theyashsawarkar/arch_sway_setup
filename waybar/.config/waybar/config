{
	"layer": "top",
	"position": "top",
	"height": 41,
	"spacing": 5,

	"modules-center": ["custom/notifications", "clock#time", "clock"],
	"modules-left": ["sway/workspaces", "bluetooth", "network", "network#speed"],

	"modules-right": [
		"custom/capslock",
		"custom/numlock",
		"custom/theme",
		"custom/wallpaper",
		"custom/docker",
		"custom/caffeine",
		"backlight",
		"pulseaudio",
		"battery",
		"custom/power"
	],

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}",
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": []
		}
	},

	"backlight": {
		"format": "{icon}  {percent}%",
		"format-icons": ["󰪞", "󰪠", "󰪢", "󰪤", "󰪥"],
		"tooltip-format": "Click: drag to set   Scroll: +/-5%",
		"on-click": "/home/yash/.local/bin/brightness-slider.sh",
		"on-scroll-up": "/home/yash/.config/sway/scripts/brightness_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/brightness_osd.sh 5%-",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/capslock": {
		"exec": "/home/yash/.local/bin/keylock-status.sh capslock",
		"on-click": "/home/yash/.local/bin/keylock-toggle.sh capslock",
		"interval": 1,
		"return-type": "json",
		"hide-empty-text": true
	},

	"custom/numlock": {
		"exec": "/home/yash/.local/bin/keylock-status.sh numlock",
		"on-click": "/home/yash/.local/bin/keylock-toggle.sh numlock",
		"interval": 1,
		"return-type": "json",
		"hide-empty-text": true
	},

	"clock": {
	// Date half. Time lives in a separate "clock#time" instance right next
	// to it -- waybar's clock format only accepts one {:...} placeholder
	// per module (confirmed: a second one throws "invalid arg-id in format
	// string"), so two colors means two module instances, same pattern as
	// network/network#speed.
	"format": "  {:%a, %B %d}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	"custom/notifications": {
		"exec": "/home/yash/.local/bin/notification-history-status.sh",
		"interval": 5,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/notification-history.py",
		"on-scroll-up": "/home/yash/.local/bin/notification-mode.sh next",
		"on-scroll-down": "/home/yash/.local/bin/notification-mode.sh prev",
		"signal": 8
	},

	"clock#time": {
	"format": "{:%I:%M %p}",
	"tooltip": false
	},

	"custom/theme": {
		"exec": "/home/yash/.local/bin/theme-status.sh",
		"interval": 5,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/theme-toggle.sh"
	},

	"custom/wallpaper": {
		"format": "",
		"tooltip-format": "Click to fetch a new wallpaper",
		"on-click": "/home/yash/.local/bin/fetch_wallpaper.sh"
	},

	"custom/docker": {
		"exec": "/home/yash/.local/bin/docker-status.sh",
		"interval": 5,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/docker-picker.py"
	},

	"network": {
		"format-wifi": "{icon}  {essid}",
		"format-ethernet": "  {ipaddr}",
		"format-disconnected": "  Offline",
		"format-disabled": "  Disabled",
		"format-linked": "  No IP",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"interval": 2,
		"max-length": 30,
		"tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%  ({signaldBm} dBm)\nFrequency: {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"tooltip-format-disabled": "Wi-Fi disabled (rfkill)",
		"on-click": "/home/yash/.local/bin/wifi-picker.py"
	},

	"network#speed": {
		"interval": 2,
		"format": "<span color='#A6E3A1'> {bandwidthDownBytes}</span>  <span color='#FAB387'> {bandwidthUpBytes}</span>",
		"tooltip": false
	},

	"bluetooth": {
		"format-off": "",
		"format-on": "",
		"format-connected": "  {device_alias}",
		"format-connected-battery": "  {device_alias}  {device_battery_percentage}%",
		"tooltip-format": "Bluetooth Status: {status}",
		"on-click": "/home/yash/.local/bin/bluetooth-picker.py",
		"max-length": 25
	},

	"custom/caffeine": {
		"exec": "~/.local/bin/caffeine-status.sh",
		"on-click": "~/.local/bin/caffeine-toggle.sh",
		"interval": 5,
		"return-type": "json"
	},

	"battery": {
		"states": {
			"critical": 15,
			"warning": 30,
			"moderate": 60
		},
		"format": "{icon}  {capacity}%",
		"format-charging": "{icon}  {capacity}%",
		"format-plugged": "{icon}  {capacity}%",
		"format-icons": {
			"charging": ["󰢜", "󰂈", "󰂉", "󰂊", "󰂅"],
			"default": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
		}
	},

	"pulseaudio": {
		// Icon wrapped in its own Pango span, sized up independent of the
		// percent text -- the plain glyphs measured out at ~4-5px of actual
		// ink at the bar's 12px base font-size (confirmed directly: cropped
		// a real screenshot down to just the icon and measured its exact
		// pixel bounding box), which is what actually made it "too small to
		// notice", not any particular volume level. A *static* span size --
		// not a per-state font-size override -- so it's the exact same size
		// at every volume level and on every waybar startup, never a
		// runtime jump: bumping font-size on a *dynamic* state elsewhere in
		// this bar once visibly popped the whole bar taller for a moment
		// (see #custom-capslock.locked's own comment in style.css) --
		// avoided here by keeping the bigger size constant from the first
		// frame onward, nothing to jump between.
		"format": "<span size='16384'>{icon}</span>  {volume}%",
		"format-muted": "<span size='16384'>󰝟</span>  Muted",
		// Threshold-object form (waybar's own ALabel::getIcon supports
		// {"icon", "max"} pairs, not just an evenly-bucketed plain array --
		// confirmed straight from waybar's own source, src/ALabel.cpp) --
		// gives an exact 0% bucket of its own. Previously a plain 3-item
		// array, evenly divided into thirds by volume percentage -- 0% fell
		// into the same bucket as anything up to 33%, so it showed the same
		// "low volume" glyph as e.g. 20%, not anything muted-looking, even
		// though 0% is audibly silent either way. Reuses format-muted's own
		// crossed-out glyph -- 0%-but-technically-unmuted and actually-
		// muted are both silent to the ear, so they should look the same,
		// not like two different states.
		"format-icons": {
			"default": [
				{"icon": "󰝟", "max": 0},
				{"icon": "󰕿", "max": 33},
				{"icon": "󰖀", "max": 66},
				{"icon": "󰕾", "max": 100}
			]
		},
		"tooltip-format": "Click: mute/unmute   Right-click: mixer   Scroll: +/-5%",
		"on-click": "/home/yash/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "/home/yash/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/power": {
		"format": "",
		"tooltip": false,
		"on-click": "nwg-bar"
	}
}
