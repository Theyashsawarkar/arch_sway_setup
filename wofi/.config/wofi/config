# ~/.config/wofi/config
show=drun,run
# 60% of screen width for every wofi popup in this desktop, not just the
# app launcher -- confirmed wofi supports percentage width (swaymsg -t
# get_outputs echoes back the literal pixel math, e.g. 1152 on a 1920px
# output). Set here instead of repeating "--width 60%" on every
# individual invocation site, so there's exactly one place controlling
# it and nothing can drift out of sync with it.
width=60%
height=400
prompt=Search Apps and Commands...
allow_markup=true
allow_images=true
image_size=32
term=kitty

# Performance and visuals
normal_window=false
insensitive=true
no_actions=true
